{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,bot/**,.github/**,.venv/**,.tmp/**,data/**,deploy/**,**/__pycache__/**,config/bot.yaml}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/collect",
      "schedule": "0 * * * *"
    }
  ]
}
